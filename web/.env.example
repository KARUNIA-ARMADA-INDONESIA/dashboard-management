# ==============================================================
# KARUNIA Management Dashboard — Environment Variables
# Salin file ini ke .env lalu isi nilai sesungguhnya.
# File .env TIDAK di-commit ke git (sudah di-ignore).
# ==============================================================

# --- Database (PostgreSQL) ---
# Password boleh berisi karakter spesial, akan di-encode otomatis.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=karunia_dashboard
DB_SCHEMA=public
# true jika server wajib SSL (umumnya server remote/cloud)
DB_SSL=false
