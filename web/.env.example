# --- Database (PostgreSQL) — dipakai pada tahap 2 (integrasi data) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/karunia_dashboard?schema=public"
